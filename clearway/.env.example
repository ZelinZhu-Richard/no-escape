# Copy to clearway/.env, then add the key privately in your editor.
# clearway/.env is ignored by Git. Never paste its contents into chat or logs.
# Restart make serve after editing. Existing shell environment values win.
# Values are read literally; shell commands and variable expansion do not run.
GEMINI_API_KEY=

# These selected model/version defaults also apply when only the key is set.
# The first actual request must still validate the returned model version.
# Adding a key/model does not authorize billing or bypass request/spend caps.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL_VERSION=gemini-3.5-flash-lite

# Optional local app settings. Keep both services on the same data directory.
# CLEARWAY_DATA_DIR=/absolute/path/inside/this/project/clearway/data
# PUBLIC_BASE_URL=https://your-intentionally-created-responder-origin
