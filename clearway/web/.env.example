# Use the schematic map for automated fixture tests; default false uses OSM.
VITE_MAP_OFFLINE=false

# Optional browser-scoped Cesium ion token. Keep .env local and restrict the
# token's scopes/origins in Cesium. Never put provider server secrets here.
VITE_CESIUM_ION_TOKEN=

# Explicit opt-in only, after confirming account eligibility and quota.
VITE_PHOTOREALISTIC_TILES=false
